{
  "expo": {
    "name": "克拉尾翼控制器",
    "slug": "kela-wing-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kela.wingcontroller",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "需要使用蓝牙连接电动尾翼设备，并发送升降控制指令、读取设备状态",
        "NSBluetoothPeripheralUsageDescription": "需要使用蓝牙连接电动尾翼设备"
      }
    },
    "plugins": [
      "react-native-ble-plx"
    ]
  }
}
